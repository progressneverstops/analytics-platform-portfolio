    <!-- JavaScript for Detective Animation -->
    <script>
        window.addEventListener('scroll', function() {
            const detective = document.getElementById('detective');
            const scrollPosition = window.scrollX;
            const windowWidth = window.innerWidth;

            // Calculate the detective's position based on scroll
            const maxScroll = 3000; // Adjust based on total scroll width
            const constrainedScroll = Math.min(scrollPosition, maxScroll);

            // Move the detective horizontally with the scroll
            detective.style.left = `${20 + (constrainedScroll * 0.5)}px`;

            // Adjust y-axis based on abstraction level
            if (scrollPosition < windowWidth) {
                detective.style.bottom = '60px'; // Surface level
            } else if (scrollPosition < windowWidth * 2) {
                detective.style.bottom = '40px'; // Code level
            } else if (scrollPosition < windowWidth * 3) {
                detective.style.bottom = '50px'; // Data level
            } else {
                detective.style.bottom = '30px'; // Binary level
            }
        });
    </script>
